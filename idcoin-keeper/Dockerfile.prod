# idcoin-keeper production image.
#
# Builds ON TOP of the production orderbook-service image so that Node v20,
# /app/mvcswap-core (contracts, tslib, scrypt_helper) and the compiled
# orderbook artifacts are byte-identical to the running sidecar.
#
# Prerequisites on the build host:
#   docker load -i metaid-orderbook-service-v1.0.tar   # base image present
#   sh scripts/make-build-context.sh /tmp/keeperctx    # build this context
#   cd /tmp/keeperctx && docker build -f Dockerfile.prod -t idcoin-keeper:v1.0 .
#
# Build context layout (produced by make-build-context.sh):
#   Dockerfile.prod
#   orderbook-service/src/**        (current repo src — overlays the base image's,
#                                    which may predate the fundingAddress patch 0f011ad)
#   idcoin-keeper/src|package.json|package-lock.json|tsconfig*.json
FROM metaid-orderbook-service:v1.0

# overlay the current orderbook-service sources (keeper imports them in-process)
RUN rm -f /app/orderbook-service/src/*.js
COPY orderbook-service/src /app/orderbook-service/src

# install the keeper with its own dependency tree. npm ci on linux/node20 pulls
# the better-sqlite3 prebuilt binary (prebuild-install); no compiler needed.
COPY idcoin-keeper/package.json idcoin-keeper/package-lock.json /app/idcoin-keeper/
WORKDIR /app/idcoin-keeper
RUN npm ci --no-audit --no-fund
COPY idcoin-keeper/tsconfig.json idcoin-keeper/tsconfig.build.json /app/idcoin-keeper/
COPY idcoin-keeper/src /app/idcoin-keeper/src

# sanity: the native module must load on this platform, and the cross-package
# imports must resolve. Fails the build otherwise.
RUN node -e "require('better-sqlite3'); console.log('better-sqlite3 native OK')" \
 && (npx tsc -p tsconfig.build.json --noEmit > /tmp/tsc.log 2>&1 || true) \
 && cat /tmp/tsc.log \
 && ! grep -E "^src/" /tmp/tsc.log \
 && rm -rf /app/idcoin-keeper/dist

# non-root runtime user; /app/data holds the SQLite ledger (volume-mounted)
RUN useradd -r -u 1000 -m keeper 2>/dev/null || adduser -D -u 1000 keeper 2>/dev/null || true \
 && mkdir -p /app/data \
 && chown -R 1000:1000 /app/data /app/idcoin-keeper
USER 1000

ENV IDCOIN_KEEPER_DB=/app/data/idcoin-keeper.db \
    MVCSWAP_CORE_DIR=/app/mvcswap-core \
    ORDERBOOK_ARTIFACTS_DIR=/app/orderbook-service/data/compiled-orderbook \
    ORDERBOOK_NET=livenet

# ops endpoint binds 127.0.0.1:18090 inside the container — never published
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:18090/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

CMD ["npx", "ts-node", "--transpile-only", "src/index.ts"]
